{
  "name": "Judge (Gemini on Vertex AI, EU)",
  "owner": "CHANGE ME: whose Google Cloud project this is",
  "environment": "dev",
  "request": {
    "url": "https://aiplatform.eu.rep.googleapis.com/v1/projects/CHANGE-ME-PROJECT/locations/eu/endpoints/openapi/chat/completions",
    "headers": {
      "Authorization": "Bearer ${ENV:VERTEX_TOKEN}"
    },
    "body": {
      "model": "CHANGE-ME-MODEL",
      "messages": "{{messages}}",
      "temperature": 0
    }
  },
  "reply": "choices.0.message.content",
  "conversation": {
    "style": "messages"
  },
  "limits": {
    "seconds_between": 0,
    "timeout": 90
  }
}
